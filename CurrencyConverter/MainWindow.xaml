<Window x:Class="CurrencyConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CurrencyConverter"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="900" MaxWidth="900" MinWidth="900" MaxHeight="400" MinHeight="400">
    <Grid>
        <Grid VerticalAlignment="Top" Height="30px" Background="#FF1F1F1F">
            <Grid HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="185px"  Margin="5,5,5,5">
                <Button Width="90" HorizontalAlignment="Left" HorizontalContentAlignment="Center" Content="About program" Background="Transparent" Foreground="#FFB1B1B1" Style="{StaticResource NoMouseOverButtonStyle}">
                </Button>
                <Button Width="90" HorizontalAlignment="Right" HorizontalContentAlignment="Center" Content="Help" Background="Transparent" Foreground="#FFB1B1B1" Style="{StaticResource NoMouseOverButtonStyle}">
                </Button>
            </Grid>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="60px"  Margin="5,5,5,5">
                <Button Content="Exit" Background="Transparent" Foreground="#FFB1B1B1" Style="{StaticResource NoMouseOverButtonStyle}">
                </Button>
            </Grid>
        </Grid>
        <Grid VerticalAlignment="Bottom" Height="331px" Background="#FF4E4E4E">

        </Grid>
    </Grid>
</Window>
   
